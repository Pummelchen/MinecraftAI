# XAIOS updater — /var/xaios_updater
#
# https://xaios.91.99.176.243.nip.io
#
# ASSUMPTION: serves static files from /var/xaios_updater/public. If the
# updater is an app server instead, delete the handle block and uncomment
# the proxy.

{$XAIOS_SITE_ADDRESS:xaios.91.99.176.243.nip.io} {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	route {
		@sensitive path_regexp (?i)(?:^|/)(?:.*\.db|.*\.db-wal|.*\.db-shm|.*\.sqlite3?|.*\.bak|.*\.old|.*\.tmp|\.env)$
		respond @sensitive 404

		# An updater usually serves immutable versioned artifacts plus a mutable
		# manifest that must never be cached. Uncomment and adjust the paths once
		# the layout is known — serving a stale manifest is how clients get stuck
		# on an old version.
		# @manifest path /latest.json /manifest.json
		# header @manifest Cache-Control "no-store, max-age=0"
		# @versioned path /releases/*
		# header @versioned Cache-Control "public, max-age=31536000, immutable"

		# App server instead of static files:
		# reverse_proxy {$XAIOS_UPSTREAM:127.0.0.1:8803} {
		# 	header_up X-Real-IP {remote_host}
		# }

		handle {
			root * {$XAIOS_SITE_ROOT:/var/xaios_updater/public}
			try_files {path} {path}/ /index.html
			file_server
		}
	}

	log {
		output file {$CADDY_LOG_DIR:/var/log/caddy}/xaios.log {
			roll_size 20MiB
			roll_keep 5
		}
		format json
	}
}

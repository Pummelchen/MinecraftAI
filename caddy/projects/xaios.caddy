# XAIOS updater — https://xaios.91.99.176.243.nip.io
# Own web server: /var/xaios_updater/caddy, xaios-caddy.service
#
# Serves plain HTTP on 8090, so this hop is the only TLS in front of it — which
# is new: before the master existed it was reachable over unencrypted HTTP only.
#
# Follow-up for XAIOS: bind loopback-only, so 8090 stops answering directly.

{$XAIOS_SITE_ADDRESS:xaios.91.99.176.243.nip.io} {
	reverse_proxy {$XAIOS_UPSTREAM:127.0.0.1:8090} {
		# Preserve the client's Host. Caddy sends the dial address as Host to an
		# HTTPS upstream otherwise, so a project whose own config matches a
		# specific hostname sees "127.0.0.1:<port>", matches nothing, and returns
		# a bare empty 200 — a success status with no body and no error anywhere.
		# Projects matching any host hide the bug; this one is what makes the
		# router correct for all of them.
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file {$CADDY_LOG_DIR:/var/log/caddy}/xaios.log {
			roll_size 20MiB
			roll_keep 5
		}
		format json
	}
}

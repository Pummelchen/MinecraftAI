(pummelchen_primary_proxy) {
	request_body {
		max_size 256KiB
	}
	header Cache-Control "no-store, max-age=0"
	reverse_proxy {$PUMMELCHEN_API_26_1_2:127.0.0.1:8787} {
		header_up X-Real-IP {remote_host}
		transport http {
			dial_timeout 5s
			response_header_timeout 35s
			read_timeout 35s
			write_timeout 35s
		}
	}
}

(pummelchen_routes) {
	root * {$PUMMELCHEN_SITE_ROOT:/var/minecraftai/web/site/public}
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	route {
		@sensitive path_regexp sensitive (?i)(?:^|/)(?:.*\.duckdb|.*\.sqlite3?|.*\.db|.*backup.*|.*\.bak|.*\.old|.*\.tmp|.*headless-live-soak\.json)$
		respond @sensitive 404

		handle_path /api/26.1.2/* {
			rewrite * /api{uri}
			import pummelchen_primary_proxy
		}

		handle_path /api/26.2/* {
			rewrite * /api{uri}
			request_body {
				max_size 256KiB
			}
			header Cache-Control "no-store, max-age=0"
			reverse_proxy {$PUMMELCHEN_API_26_2:127.0.0.1:8788} {
				header_up X-Real-IP {remote_host}
				transport http {
					dial_timeout 5s
					response_header_timeout 35s
					read_timeout 35s
					write_timeout 35s
				}
			}
		}

		handle_path /api/26.3/* {
			rewrite * /api{uri}
			request_body {
				max_size 256KiB
			}
			header Cache-Control "no-store, max-age=0"
			reverse_proxy {$PUMMELCHEN_API_26_3:127.0.0.1:8789} {
				header_up X-Real-IP {remote_host}
				transport http {
					dial_timeout 5s
					response_header_timeout 35s
					read_timeout 35s
					write_timeout 35s
				}
			}
		}

		handle /api/* {
			import pummelchen_primary_proxy
		}

		@live_stats path /live-stats.json
		handle @live_stats {
			rewrite * /api/v1/site/live-stats
			import pummelchen_primary_proxy
		}

		@update_activity path /update-activity.json
		handle @update_activity {
			rewrite * /api/v1/site/update-activity
			import pummelchen_primary_proxy
		}

		@neoforge_version path /neoforge-version.json
		handle @neoforge_version {
			rewrite * /api/v1/site/neoforge-version
			import pummelchen_primary_proxy
		}

		@release_health path /release-health.json
		handle @release_health {
			rewrite * /api/v1/site/release-health
			import pummelchen_primary_proxy
		}

		@server_versions path /server-versions.json
		handle @server_versions {
			rewrite * /api/v1/minecraft/server-versions
			import pummelchen_primary_proxy
		}

		@current_release path_regexp current_release ^/downloads/current-release(?:[-.][^/]*)?\.(?:json|txt)$
		handle @current_release {
			header {
				Cache-Control "no-store, max-age=0, must-revalidate"
				Pragma "no-cache"
				Expires "0"
			}
			file_server
		}

		handle /downloads/releases/* {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		handle /downloads/* {
			header Cache-Control "public, max-age=60"
			file_server
		}

		handle {
			header {
				Cache-Control "no-store, no-cache, max-age=0, must-revalidate"
				Pragma "no-cache"
				Expires "0"
			}
			try_files {path} {path}/ /index.html
			file_server
		}
	}
}

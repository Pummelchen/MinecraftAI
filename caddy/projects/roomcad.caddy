# RoomCAD — https://roomcad.91.99.176.243.nip.io
# Own web server: /var/roomcad/caddy, roomcad-caddy.service
#
# RoomCAD's Caddy terminates TLS itself on 8443 with a certificate it manages,
# so this hop speaks HTTPS to it and verifies against that certificate's name.
# Untouched on purpose — RoomCAD owns its own deploy.
#
# Follow-ups for RoomCAD to make when it suits them, not for this file:
#   - listen on plain HTTP on loopback instead, and drop the double TLS
#   - retire renew-certificate.sh; the master now issues this hostname
#   - bind loopback-only, so 8443 stops being reachable from outside

{$ROOMCAD_SITE_ADDRESS:roomcad.91.99.176.243.nip.io} {
	reverse_proxy {$ROOMCAD_UPSTREAM:https://127.0.0.1:8443} {
		transport http {
			tls_server_name roomcad.91.99.176.243.nip.io
		}
		# Preserve the client's Host. Caddy sends the dial address as Host to an
		# HTTPS upstream otherwise, so a project whose own config matches a
		# specific hostname sees "127.0.0.1:<port>", matches nothing, and returns
		# a bare empty 200 — a success status with no body and no error anywhere.
		# Projects matching any host hide the bug; this one is what makes the
		# router correct for all of them.
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file {$CADDY_LOG_DIR:/var/log/caddy}/roomcad.log {
			roll_size 20MiB
			roll_keep 5
		}
		format json
	}
}
